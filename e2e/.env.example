# Public local demo seed — already committed in backend/app/services/seed.py
# and frontend/lib/mocks.ts. These are not production secrets.
# Copy to e2e/.env (gitignored) or export in the shell. Do not commit e2e/.env.

E2E_BASE_URL=http://127.0.0.1:3000
E2E_API_BASE=http://127.0.0.1:8000

# exam-prep workspace from seed.py WS_EXAM
E2E_WORKSPACE_ID=aaaaaaaa-0001-4000-8000-000000000001
E2E_WORKSPACE_LABEL=Coaching exam-prep

# Auth stub. OTP is mock; there is no mailbox. See backend/app/config.py otp_code.
E2E_OTP_CODE=000000

# Shared demo password hashed in seed (backend/app/services/auth.py DEMO_PASSWORD).
E2E_DEMO_PASSWORD=TutorDemo1

# Usernames (Identity kind=username) for the exam-prep seed.
E2E_OWNER_USERNAME=vikram
E2E_TEACHER_USERNAME=sudhakshina
E2E_ASSISTANT_USERNAME=rohan
E2E_STUDENT_USERNAME=aarav
E2E_PARENT_USERNAME=rajesh

# Phones are prefix + role initial. exam-prep prefix is +9101.
E2E_OWNER_PHONE=+9101o
E2E_TEACHER_PHONE=+9101t
E2E_ASSISTANT_PHONE=+9101a
E2E_STUDENT_PHONE=+9101s
E2E_PARENT_PHONE=+9101p

E2E_STUDENT_EMAIL=student@exam-prep.sim
E2E_TEACHER_EMAIL=teacher@exam-prep.sim
E2E_PARENT_EMAIL=parent@exam-prep.sim

# Seeded student display name used by the roster assertion.
E2E_STUDENT_DISPLAY_NAME=Aarav Sharma
