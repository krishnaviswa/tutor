# Names only. All providers default to mock in CI. Never commit real secrets.

# 002 sim default is SQLite file; Postgres URL is the production shape.
DATABASE_URL=sqlite:///backend/data/sim.db
JWT_SECRET=dev-only-sim-secret
SMS_PROVIDER=mock
EMAIL_PROVIDER=mock
VIDEO_PROVIDER=mock
STORAGE_PROVIDER=local
PAYMENTS_STUDENT_PROVIDER=mock
PAYMENTS_PLATFORM_PROVIDER=mock
PUSH_PROVIDER=mock
WHATSAPP_PROVIDER=mock
SPECIFY_FEATURE_DIRECTORY=specs/002-sim-spine
