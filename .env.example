EMAIL_PROVIDER=mock
VIDEO_PROVIDER=mock
STORAGE_PROVIDER=local
PAYMENTS_STUDENT_PROVIDER=mock
PAYMENTS_PLATFORM_PROVIDER=mock
PUSH_PROVIDER=mock
